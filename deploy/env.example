# Settings for the deploy/ scripts. Copy to env.local (git-ignored) and fill in.
# Every script sources env.local when it exists; variables already set in the
# environment take precedence.

# GCP project and region for the sandbox cluster.
PROJECT=my-project
REGION=asia-east1
# Zones for both node pools. Each must offer GVISOR_MACHINE_TYPE.
NODE_ZONES=asia-east1-a,asia-east1-b

# Existing custom-mode VPC to attach the cluster to.
NETWORK=my-vpc
CLUSTER=agent-sandbox-asia-east1
SUBNET=agent-sandbox-asia-east1
# Must not overlap any other range in NETWORK or in networks peered with it.
NODE_RANGE=10.90.0.0/20
POD_RANGE=10.92.0.0/14
SERVICE_RANGE=10.96.0.0/20

# CIDRs allowed to reach the control plane, comma-separated. Include the public
# egress IP of every machine that runs kubectl or the SDK.
AUTHORIZED_NETWORKS=203.0.113.10/32

# gVisor node pool. Max nodes is per zone.
GVISOR_POOL=gvisor-n2-highmem-8
GVISOR_MACHINE_TYPE=n2-highmem-8
GVISOR_DISK_TYPE=pd-balanced
GVISOR_DISK_SIZE_GB=200
GVISOR_MAX_NODES=5

# Notification channels for the alert policies, comma-separated full resource
# names (projects/<project>/notificationChannels/<id>). Empty means incidents
# show in the Cloud Monitoring console but notify no one.
ALERT_CHANNELS=

# agent-sandbox release and the namespace the tests use.
AGENT_SANDBOX_VERSION=v1.0.9
SANDBOX_NAMESPACE=agent-sandbox-rl
